APP_USERNAME=wordle
# Use either a raw bcrypt hash, or a compose-safe base64 form like:
# base64:JDJiJDEyJH...
APP_PASSWORD_HASH=base64:replace_with_base64_encoded_bcrypt_hash
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=wordle_rl_session
SESSION_COOKIE_SECURE=true

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
RPC_QUEUE=wordle_suggest
RPC_TIMEOUT_SECONDS=8

MODEL_PATH=/opt/wordle/runs/ppo/best_model/best_model.zip
DATA_DIR=/opt/wordle/data
MAX_TURNS=6
TOP_K_DEFAULT=10
TOP_K_MAX=25
